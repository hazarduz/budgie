// Budgie — personal budget tracker
// Prisma schema for a self-hosted PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryType {
  DEBIT
  PLANNED
}

enum Role {
  ADMIN
  STANDARD
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  passwordHash      String
  role              Role               @default(STANDARD)
  showEntryIcons    Boolean            @default(true)
  theme             Theme              @default(SYSTEM)
  avatar            String?            @db.Text
  // Default Start With amount used when a month is populated from Master.
  masterStartWith   Decimal            @default(0) @db.Decimal(10, 2)
  createdAt         DateTime           @default(now())
  months            Month[]
  categories        Category[]
  accounts          Account[]
  christmasEntries  ChristmasEntry[]
  christmasSettings ChristmasSettings?
  debts             Debt[]
  masterBills       MasterBill[]
}

model Category {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  color       String       @default("#0d9488")
  isDefault   Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  entries     Entry[]
  masterBills MasterBill[]

  @@unique([userId, name])
}

model Account {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  color       String       @default("#0d9488")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  entries     Entry[]
  masterBills MasterBill[]

  @@unique([userId, name])
}

model Month {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  startWith Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   Entry[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model Entry {
  id         String    @id @default(cuid())
  month      Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  monthId    String
  name       String
  amount     Decimal   @db.Decimal(10, 2)
  type       EntryType @default(DEBIT)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId  String?
  notes      String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([monthId])
}

// A recurring monthly debit (Rent, Council Tax, ...) that new months are
// auto-populated from when created. Editing a bill here only affects months
// created afterwards — it's a template, not a live link, so already-created
// months (including history) never change retroactively.
model MasterBill {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  amount     Decimal   @db.Decimal(10, 2)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId  String?
  notes      String?
  // Paused bills are kept (not deleted) but skipped when populating a new month.
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model ChristmasSettings {
  id     String  @id @default(cuid())
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String  @unique
  budget Decimal @default(250) @db.Decimal(10, 2)
}

model ChristmasEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  recipient String
  item      String
  amount    Decimal  @db.Decimal(10, 2)
  purchased Boolean  @default(false)
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Debt {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  direction      DebtDirection @default(I_OWE)
  name           String
  category       String?
  amount         Decimal       @db.Decimal(10, 2)
  monthlyPayment Decimal?      @db.Decimal(10, 2)
  endDate        DateTime?
  settled        Boolean       @default(false)
  notes          String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
}

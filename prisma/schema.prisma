// Budgie — personal budget tracker
// Prisma schema for a self-hosted PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryType {
  DEBIT
  PLANNED
}

enum Role {
  ADMIN
  STANDARD
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  passwordHash      String
  role              Role               @default(STANDARD)
  createdAt         DateTime           @default(now())
  months            Month[]
  categories        Category[]
  accounts          Account[]
  christmasEntries  ChristmasEntry[]
  christmasSettings ChristmasSettings?
  debts             Debt[]
}

model Category {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  color     String   @default("#0d9488")
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  entries   Entry[]

  @@unique([userId, name])
}

model Account {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  color     String   @default("#0d9488")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  entries   Entry[]

  @@unique([userId, name])
}

model Month {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  startWith Decimal  @db.Decimal(10, 2) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   Entry[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model Entry {
  id         String    @id @default(cuid())
  month      Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  monthId    String
  name       String
  amount     Decimal   @db.Decimal(10, 2)
  type       EntryType @default(DEBIT)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId  String?
  notes      String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([monthId])
}

model ChristmasSettings {
  id     String  @id @default(cuid())
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String  @unique
  budget Decimal @db.Decimal(10, 2) @default(250)
}

model ChristmasEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  recipient String
  item      String
  amount    Decimal  @db.Decimal(10, 2)
  purchased Boolean  @default(false)
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Debt {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  direction      DebtDirection @default(I_OWE)
  name           String
  category       String?
  amount         Decimal       @db.Decimal(10, 2)
  monthlyPayment Decimal?      @db.Decimal(10, 2)
  endDate        DateTime?
  settled        Boolean       @default(false)
  notes          String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
}
